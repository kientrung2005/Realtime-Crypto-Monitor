# Binance public market data
BINANCE_WEBSOCKET_URL=wss://stream.binance.com:9443/ws
BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt
BINANCE_STREAM=aggTrade

# Bybit public Spot market data
BYBIT_WEBSOCKET_URL=wss://stream.bybit.com/v5/public/spot
BYBIT_SYMBOLS=btcusdt,ethusdt,solusdt

# OKX public Spot market data
OKX_WEBSOCKET_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT

# Kafka connections
KAFKA_HOST_PORT=9094
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka:9092
KAFKA_NUM_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1
KAFKA_RETENTION_HOURS=24
KAFKA_SPOT_TRADES_TOPIC=crypto.spot.trades.v1
KAFKA_SPOT_QUOTES_TOPIC=crypto.spot.quotes.v1
KAFKA_ALERTS_TOPIC=crypto.market-alerts.v1
KAFKA_DEAD_LETTER_TOPIC=crypto.dead-letter.v1

# Spark standalone cluster
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=2g
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=2g
SPARK_CHECKPOINT_LOCATION=/opt/spark/checkpoints
SPARK_STREAMING_TRIGGER_SECONDS=20
SPARK_IVY_CACHE_LOCATION=/opt/spark/ivy
SPARK_DRIVER_HOST=spark-streaming
SPARK_EXECUTOR_PYTHON=/usr/bin/python3

# Superset
SUPERSET_SECRET_KEY=replace_with_a_long_random_secret_key
SUPERSET_METADATA_DATABASE=superset
SUPERSET_METADATA_USER=superset
SUPERSET_METADATA_PASSWORD=replace_with_a_strong_password
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=Crypto
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HOST_DOCKER=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=crypto_market
CLICKHOUSE_USER=crypto_user
CLICKHOUSE_PASSWORD=password
# MinIO object storage
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ENDPOINT=localhost:9002
MINIO_ENDPOINT_DOCKER=minio:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=crypto_minio
MINIO_SECRET_KEY=crypto_minio_password
MINIO_BUCKET=crypto-market-data
MINIO_REGION=us-east-1
MINIO_RETENTION_DAYS=30
MINIO_ARCHIVE_PREFIX=market-data
MINIO_ARCHIVE_OUTPUT_PARTITIONS=1
MINIO_COMPACTION_ENABLED=true
MINIO_COMPACTION_INITIAL_DELAY_SECONDS=120
MINIO_COMPACTION_INTERVAL_SECONDS=900
MINIO_COMPACTION_MIN_AGE_MINUTES=10
MINIO_COMPACTION_MIN_FILES=2

